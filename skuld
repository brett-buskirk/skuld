#!/usr/bin/env bash
# skuld — a pocket CLI task-tracker: the ledger of what you owe your future self.
#
# Skuld is the Norn who governs what shall be — her name is cognate with "shall"
# and "should", and carries the older sense of *debt, obligation, that-which-must-
# become*. So skuld is edda's sibling and mirror: edda records what *was* (a vault
# of notes), skuld records what *shall be* (a checklist of tasks). It owns exactly
# one directory — the store — and never reaches beyond it: every write lands inside
# $SKULD_HOME, mutations are atomic, nothing is ever hard-deleted, and skuld never
# phones home.
#
#   skuld add <name…>        add a task            skuld list              open tasks
#   skuld show <id>          a task in full        skuld edit <id> …       change a field
#   skuld close <id>         mark it done          skuld reopen <id>       reopen a task
#   skuld rm <id>            soft-delete a task    skuld init              scaffold the store
#   skuld                    (no verb) list open tasks
#   skuld <id>               (no verb) show that task
#
#   skuld help  ·  skuld <command> help   for the menu and per-command detail.
#
# Deps: bash + coreutils, nothing else. Fully offline; the store is a single
# tab-separated file you can read, grep, and back up yourself. Drop it in
# ~/.local/bin and run it anywhere.
# shellcheck disable=SC2059  # color vars are fixed ANSI codes, deliberately embedded in format strings
set -uo pipefail

VERSION="0.5.0"

# ── configuration — env  >  config file  >  default store ─────────────────────
# The muninn ladder: capture the SKULD_HOME env override *before* sourcing the
# config (so the environment always wins over the file), source the config if it
# exists, then resolve env > file > default. The config is a plain sourced shell
# file that sets SKULD_HOME=…; 'skuld init' writes a starter one.
CONFIG="${SKULD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/skuld/config}"
_env_HOME="${SKULD_HOME-}"
# shellcheck source=/dev/null
[ -f "$CONFIG" ] && . "$CONFIG"
DEFAULT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/skuld"
SKULD_HOME="${_env_HOME:-${SKULD_HOME:-$DEFAULT_HOME}}"
STORE="$SKULD_HOME/tasks.tsv"          # the ledger: one task per line, tab-separated
TRASH="$SKULD_HOME/.trash"             # soft-deletes land here; never a hard delete
US=$'\x1f'                             # internal field separator (see store_read)

# The fixed column order of a task record. The store is TSV on disk; internally
# records use US (0x1f) between fields (see store_read for why). This order is the
# machine-readable contract — later versions append, never reorder.
#   id ⇥ status ⇥ priority ⇥ created ⇥ due ⇥ completed ⇥ name ⇥ description

# ── palette — color only on a TTY, and never when NO_COLOR is set ─────────────
# Same convention as the rest of the pack: piped/redirected output, or NO_COLOR,
# collapses every escape to an empty string, so output is plain text downstream.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; DIM=$'\e[2m'; BD=$'\e[1m'; X=$'\e[0m'
else R=; G=; Y=; C=; DIM=; BD=; X=; fi

# ── small helpers ─────────────────────────────────────────────────────────────
is_help(){ case "${1:-}" in help|-h|--help) return 0;; *) return 1;; esac; }
note(){ printf "    ${DIM}%s${X}\n" "$1"; }                    # a dim aside
is_int(){ case "${1:-}" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
now_iso(){ date -u +%FT%TZ; }                                 # 2026-07-19T08:44:00Z (GNU+BSD)
today(){ date -u +%F; }                                       # 2026-07-19

# valid_due <s> — v1 accepts ONLY YYYY-MM-DD. The regex enforces the shape plus a sane
# month (01–12) and day (01–31), so obvious junk (2026-13-40, "tomorrow", 07/20/2026)
# is rejected rather than silently stored. Full calendar validity (no Feb 30) needs
# date math (GNU-only) and is a roadmap nicety; overdue detection is lexical regardless.
valid_due(){ [[ "${1:-}" =~ ^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$ ]]; }

# is_overdue <due> <status> <today> — has a due, still open, and due < today. ISO
# YYYY-MM-DD compares lexically, so no date arithmetic is needed (or wanted — lexical
# comparison keeps overdue detection portable).
is_overdue(){
  local due="$1" status="$2" ref="$3"
  [ -n "$due" ] && [ "$status" = open ] && [[ "$due" < "$ref" ]]
}

# ── storage seam — the ONLY code that knows the on-disk format ─────────────────
# enc/dec escape the two field-shearing characters (tab, newline) plus the escape
# character itself, so a name or description survives write→read byte-identical and a
# record always stays on ONE physical line. Backslash is escaped FIRST on encode and
# decoded LAST (via a single left-to-right pass) so a literal "C:\temp" round-trips.
enc(){
  local s="${1:-}"
  s="${s//\\/\\\\}"     # \  → \\   (must be first)
  s="${s//$'\t'/\\t}"   # TAB → \t
  s="${s//$'\n'/\\n}"   # LF  → \n
  printf '%s' "$s"
}
dec(){
  local s="${1:-}"
  case "$s" in *\\*) ;; *) printf '%s' "$s"; return;; esac   # no escapes → fast path
  local out="" i c nx n=${#s} bs=$'\\'
  for (( i=0; i<n; i++ )); do
    c="${s:i:1}"
    if [ "$c" = "$bs" ] && [ $(( i + 1 )) -lt "$n" ]; then
      nx="${s:i+1:1}"
      case "$nx" in
        t)     out+=$'\t'; i=$(( i + 1 ));;
        n)     out+=$'\n'; i=$(( i + 1 ));;
        "$bs") out+="$bs"; i=$(( i + 1 ));;
        *)     out+="$c";;                                    # lone backslash — keep as-is
      esac
    else
      out+="$c"
    fi
  done
  printf '%s' "$out"
}

# store_read — emit every task record, one per line, fields separated by US. On disk
# the store is TAB-separated (human-readable, greppable); internally we use US (0x1f)
# because TAB is IFS-whitespace and a `read` split would COLLAPSE empty due/completed
# columns, shearing every later field. US is non-whitespace, so `read` keeps the empty
# fields. This TAB↔US translation is why the whole rest of the tool never touches the
# on-disk format — the documented JSONL upgrade reimplements ONLY this + store_write.
store_read(){
  [ -f "$STORE" ] || return 0
  awk 'NF' "$STORE" | tr '\t' '\037'
}

# store_write — atomically REPLACE the store with the US-separated records on stdin.
# The marquee correctness rule: write a temp IN THE STORE DIR (same filesystem, so the
# mv is a true rename — a cross-mount mv would copy+unlink and lose atomicity), then mv
# it into place. A crash or Ctrl-C mid-write leaves the PREVIOUS store fully intact,
# never a half-applied rewrite; the temp is cleaned on every failure/interrupt path.
store_write(){
  local tmp rc
  tmp="$(mktemp "$SKULD_HOME/.skuld-tmp.XXXXXX")" || {
    printf "  ${R}✗ couldn't create a temp file in %s${X}\n" "$SKULD_HOME" >&2; return 1; }
  trap 'rm -f "$tmp"' INT TERM
  if tr '\037' '\t' > "$tmp" && mv "$tmp" "$STORE"; then rc=0; else rc=1; rm -f "$tmp"; fi
  trap - INT TERM
  return "$rc"
}

# next_id — highest id in the US-separated records on stdin, plus one; 1 for an empty
# store. IDs are monotonic and NEVER reused (max+1, not a count), so a deleted #4 never
# returns. cmd_add computes this from the same snapshot it rewrites, so a single add is
# self-consistent; a cross-process flock against two simultaneous adds is roadmap.
next_id(){ awk 'BEGIN{FS="\037"; m=0}{ if ($1+0 > m) m=$1+0 } END{ print m+1 }'; }

# build_record — assemble a record from its 8 fields (name/description encoded).
build_record(){  # id status priority created due completed name description
  printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s' \
    "$1" "$2" "$3" "$4" "$5" "$6" "$(enc "$7")" "$(enc "$8")"
}

# find_task <id> — print the US-separated record whose id matches (numeric compare, so
# "04" finds #4), reading records from stdin. Prints nothing when there's no match.
find_task(){ awk -v id="$1" 'BEGIN{FS="\037"} ($1+0)==(id+0){ print; exit }'; }

# field <n> — print field n of the US-separated record on stdin (1-based).
field(){ awk -v n="$1" 'BEGIN{FS="\037"}{ print $n; exit }'; }

# set_task_state <id> <status> <completed> — rewrite ONE task's status + completed and
# atomically replace the store. Non-matching records pass through byte-identical (awk
# only rebuilds $0 for the row it edits), so every other task's escapes are preserved.
# The whole read→transform→write runs before the mv, so reading and writing the same
# store is safe. This is the single mutator the state machine (close/reopen) drives.
set_task_state(){
  local id="$1" status="$2" completed="$3"
  store_read \
    | awk -v id="$id" -v st="$status" -v cp="$completed" \
        'BEGIN{ FS=OFS="\037" } ($1+0)==(id+0){ $2=st; $6=cp } { print }' \
    | store_write
}

# replace_task <id> <new-record> — swap the record with matching id for <new-record>
# (a full US-separated line), leaving every other record byte-identical, then atomically
# replace the store. The mutator 'edit' drives; <new-record> is built by build_record so
# its name/description are already encoded. The new record is passed through the
# ENVIRONMENT, not `awk -v` — awk interprets backslash escapes in a -v assignment, which
# would turn the encoded \t/\n back into real tabs/newlines and shear the record.
replace_task(){
  local id="$1" newrec="$2"
  store_read \
    | SKULD_NEWREC="$newrec" awk -v id="$id" \
        'BEGIN{ FS="\037" } ($1+0)==(id+0){ print ENVIRON["SKULD_NEWREC"]; next } { print }' \
    | store_write
}

# ensure_store — every task-touching command runs this first; 'init' does not.
ensure_store(){
  [ -f "$STORE" ] && return 0
  printf "\n  ${R}no store at${X} ${C}%s${X}\n" "$STORE"
  note "run ${BD}skuld init${X} to create it, or point ${BD}SKULD_HOME${X} at an existing store."
  printf "\n"
  return 1
}

# ── init — scaffold the store (ledger + .trash/) and a starter config ──────────
cmd_init(){
  is_help "${1:-}" && { help_init; return 0; }
  local force=0 a
  for a in "$@"; do case "$a" in
    -f|--force) force=1;;
    -*) printf "  ${Y}ignoring unknown option: %s${X}\n" "$a";;
  esac; done

  printf "\n  ${BD}skuld init${X}\n\n"

  # 1. the store dir + its .trash/ (where a future 'rm' soft-deletes to — never rm -f)
  if [ -d "$SKULD_HOME" ]; then
    printf "  ${DIM}·${X} store already exists → ${C}%s${X}\n" "$SKULD_HOME"
  else
    mkdir -p "$SKULD_HOME" || { printf "  ${R}✗ couldn't create the store at %s${X}\n\n" "$SKULD_HOME"; return 1; }
    printf "  ${G}✓${X} created store → ${C}%s${X}\n" "$SKULD_HOME"
  fi
  mkdir -p "$TRASH"

  # 2. the ledger itself — a single tab-separated file, one task per line. Created
  # empty; the first 'add' fills it. NEVER clobber an existing ledger (the guard
  # below is why a re-init can't truncate real task data out from under you).
  if [ -f "$STORE" ]; then
    printf "  ${DIM}·${X} ledger already exists → ${C}%s${X}\n" "$STORE"
  else
    : > "$STORE" || { printf "  ${R}✗ couldn't create the ledger at %s${X}\n\n" "$STORE"; return 1; }
    printf "  ${G}✓${X} created ledger → ${C}%s${X}\n" "$STORE"
  fi

  # 3. a starter config (a plain sourced shell file; the env still overrides it)
  if [ -f "$CONFIG" ] && [ "$force" = 0 ]; then
    printf "  ${DIM}·${X} config already exists → ${C}%s${X} ${DIM}(skuld init --force to overwrite)${X}\n" "$CONFIG"
  else
    mkdir -p "$(dirname "$CONFIG")"
    cat > "$CONFIG" <<CFG
# skuld configuration — https://github.com/brett-buskirk/skuld
# A plain sourced shell file. SKULD_HOME in the environment overrides this.
SKULD_HOME="$SKULD_HOME"
CFG
    printf "  ${G}✓${X} wrote config → ${C}%s${X}\n" "$CONFIG"
  fi

  printf "\n  ${DIM}store ready — 'skuld add <name>' to write your first task.${X}\n"
  note "tip: point SKULD_HOME at a synced/versioned dir — your task ledger is state worth backing up."
  printf "\n"
}

# ── add — append a task; the whole store is rewritten atomically ───────────────
cmd_add(){
  is_help "${1:-}" && { help_add; return 0; }
  local desc="" priority="standard" due=""
  local -a names=()
  # Flags interleave with the name words; a lone name word starts collecting the name.
  while [ $# -gt 0 ]; do case "$1" in
    -d|--desc|--description) shift; desc="${1:-}";;
    -H|--high)               priority="high";;
    --priority)              shift
      case "${1:-}" in
        standard|high) priority="$1";;
        *) printf "\n  ${R}✗ unknown priority:${X} ${BD}%s${X} ${DIM}(use: standard | high)${X}\n\n" "${1:-}"; return 1;;
      esac;;
    --due)                   shift; due="${1:-}";;
    --)                      shift; while [ $# -gt 0 ]; do names+=("$1"); shift; done; break;;
    -*)                      printf "  ${Y}ignoring unknown option: %s${X}\n" "$1";;
    *)                       names+=("$1");;
  esac; shift; done

  ensure_store || return 1
  local name="${names[*]}"
  if [ -z "${name// /}" ]; then
    printf "\n  ${R}usage:${X} skuld add [-H] [--due YYYY-MM-DD] [-d desc] <name…>\n\n"; return 1
  fi
  if [ -n "$due" ] && ! valid_due "$due"; then
    printf "\n  ${R}✗ invalid --due:${X} ${BD}%s${X} ${DIM}(v1 accepts only YYYY-MM-DD, e.g. %s)${X}\n\n" "$due" "$(today)"; return 1
  fi

  # next_id + append run against ONE snapshot, then the whole store is rewritten
  # atomically. Computing the id from the same snapshot we rewrite keeps a single add
  # self-consistent (see next_id / store_write).
  local snapshot next created rec
  snapshot="$(store_read)"
  next="$(printf '%s' "$snapshot" | next_id)"
  created="$(now_iso)"
  rec="$(build_record "$next" open "$priority" "$created" "$due" "" "$name" "$desc")"
  if ! { [ -n "$snapshot" ] && printf '%s\n' "$snapshot"; printf '%s\n' "$rec"; } | store_write; then
    printf "\n  ${R}✗ couldn't write the task — the store is unchanged.${X}\n\n"; return 1
  fi

  printf "\n  ${G}✓ added${X} ${DIM}#%s${X} ${BD}%s${X}" "$next" "$name"
  [ "$priority" = high ] && printf "  ${Y}!${X}"
  [ -n "$due" ] && printf "  ${DIM}due %s${X}" "$due"
  printf "\n\n"
}

# read_totals <today> — store-wide counts "open overdue done" from US records on stdin.
# The footer always reports these totals, independent of any list filter.
read_totals(){
  awk -v today="$1" 'BEGIN{ FS="\037"; o=0; od=0; c=0 }
    { if ($2=="closed") c++; else { o++; if ($5!="" && $5<today) od++ } }
    END{ print o, od, c }'
}

# filter_key <status> <priority> <overdue> <today> <sortkey> — from the US records on
# stdin, keep those matching the filters and PREPEND a sort key (US-separated) for the
# caller to sort on and then strip. The record ($0) comes from stdin, never `awk -v`, so
# its \t/\n escapes are preserved (a -v assignment would un-escape them).
filter_key(){
  awk -v st="$1" -v prio="$2" -v overdue="$3" -v today="$4" -v key="$5" '
    BEGIN{ FS=OFS="\037" }
    {
      status=$2; priority=$3; due=$5
      isover = (status=="open" && due!="" && due<today)
      if (st=="open"   && status!="open")   next
      if (st=="closed" && status!="closed") next
      if (overdue=="1" && !isover)          next
      if (prio!=""     && priority!=prio)   next
      if      (key=="created")  k=$4
      else if (key=="due")      k=(due==""?"9999-99-99":due)               # no-due sorts last
      else if (key=="priority") k=(priority=="high"?"0":"1") (due==""?"9999-99-99":due)
      else                      k=sprintf("%020d", $1)                     # id (default)
      print k, $0
    }'
}

# list_label <status> <priority> <overdue> — the human header / empty-message phrase.
list_label(){
  local status="$1" priority="$2" overdue="$3" label="all tasks"
  if [ "$overdue" = 1 ]; then label="overdue tasks"
  else case "$status" in open) label="open tasks";; closed) label="closed tasks";; esac; fi
  [ -n "$priority" ] && label="$priority-priority $label"
  printf '%s' "$label"
}

# ── list — tasks, with filters, sorting, and a machine-readable mode ───────────
# Human view: open tasks by default, one aligned line each, with a store-wide summary
# footer (N open · N overdue · N done — always the whole store, not the filtered view).
# Filters: --closed / --all / --priority / --overdue. Order: --sort id|due|priority|
# created (+ --reverse). --porcelain drops color/header/footer for the frozen column
# contract, so skuld composes into other tools.
#
# PORCELAIN CONTRACT — one line per task, TAB-separated, no escapes/color/header/footer;
# name and description stay backslash-encoded so every record is exactly one line. The
# column order is FROZEN — later versions only ever append:
#   id ⇥ status ⇥ priority ⇥ created ⇥ due ⇥ completed ⇥ name ⇥ description
cmd_list(){
  is_help "${1:-}" && { help_list; return 0; }
  local want_status="open" want_priority="" only_overdue=0 sort_key="id" reverse=0 porcelain=0
  while [ $# -gt 0 ]; do case "$1" in
    --open)       want_status="open";;
    --closed)     want_status="closed";;
    -a|--all)     want_status="all";;
    --overdue)    only_overdue=1;;
    -H|--high)    want_priority="high";;
    --priority)   shift; case "${1:-}" in
        high|standard) want_priority="$1";;
        *) printf "\n  ${R}✗ unknown priority:${X} ${BD}%s${X} ${DIM}(use: standard | high)${X}\n\n" "${1:-}"; return 1;; esac;;
    --sort)       shift; case "${1:-}" in
        id|due|priority|created) sort_key="$1";;
        *) printf "\n  ${R}✗ unknown sort key:${X} ${BD}%s${X} ${DIM}(use: id | due | priority | created)${X}\n\n" "${1:-}"; return 1;; esac;;
    -r|--reverse) reverse=1;;
    --porcelain)  porcelain=1;;
    -*) printf "  ${Y}ignoring unknown option: %s${X}\n" "$1";;
  esac; shift; done
  ensure_store || return 1

  local nowday; nowday="$(today)"
  # filtered + sorted records (US-separated): prepend a sort key, sort on it, strip it.
  # -s keeps ties in store (id) order, so output is deterministic.
  local -a sortcmd=(sort -s -t "$US" "-k1,1"); [ "$reverse" = 1 ] && sortcmd+=(-r)
  local records
  records="$(store_read \
    | filter_key "$want_status" "$want_priority" "$only_overdue" "$nowday" "$sort_key" \
    | "${sortcmd[@]}" | cut -d "$US" -f2-)"

  # porcelain: the frozen contract only — no color, header, or footer.
  if [ "$porcelain" = 1 ]; then
    [ -n "$records" ] && printf '%s\n' "$records" | tr '\037' '\t'
    return 0
  fi

  local label; label="$(list_label "$want_status" "$want_priority" "$only_overdue")"
  printf "\n  ${BD}skuld${X}  ${DIM}·  %s${X}\n\n" "$label"
  if [ -z "$records" ]; then
    note "no $label — 'skuld add <name>' to add one."
  else
    local id status priority created due completed name desc
    # created/completed/desc are consumed positionally only to reach name.
    # shellcheck disable=SC2034
    while IFS="$US" read -r id status priority created due completed name desc; do
      [ -z "$id" ] && continue
      local od=0; is_overdue "$due" "$status" "$nowday" && od=1
      fmt_row "$id" "$priority" "$due" "$od" "$name"; printf '\n'
    done <<< "$records"
  fi

  # footer — always the whole store, filter-independent
  local t_open t_overdue t_done
  read -r t_open t_overdue t_done < <(store_read | read_totals "$nowday")
  printf "\n  ${DIM}%d open · %d overdue · %d done${X}\n\n" "$t_open" "$t_overdue" "$t_done"
}

# fmt_row <id> <priority> <due> <overdue-flag> <name> — one aligned task line for the
# human list. The name is decoded and squashed to a single line (tabs/newlines → space)
# so a multi-line description or a tab in the name can't shear the row.
fmt_row(){
  local id="$1" priority="$2" due="$3" od="$4" name="$5"
  local pmark="  "; [ "$priority" = high ] && pmark="${Y}!${X} "
  local dname; dname="$(dec "$name")"
  dname="${dname//$US/ }"; dname="${dname//$'\t'/ }"; dname="${dname//$'\n'/ }"
  local duestr=""
  if [ -n "$due" ]; then
    if [ "$od" = 1 ]; then duestr="  ${R}due $due (overdue)${X}"; else duestr="  ${DIM}due $due${X}"; fi
  fi
  printf "    ${DIM}%3s${X} %s${BD}%s${X}%s" "$id" "$pmark" "$dname" "$duestr"
}

# ── show — one task in full ────────────────────────────────────────────────────
cmd_show(){
  is_help "${1:-}" && { help_show; return 0; }
  local id="" porcelain=0 a
  for a in "$@"; do case "$a" in
    --porcelain) porcelain=1;;
    -*) printf "  ${Y}ignoring unknown option: %s${X}\n" "$a";;
    *) [ -z "$id" ] && id="$a";;
  esac; done
  ensure_store || return 1
  [ -z "$id" ] && { printf "\n  ${R}usage:${X} skuld show <id>\n\n"; return 1; }
  if ! is_int "$id"; then
    printf "\n  ${R}✗ not a task id:${X} ${BD}%s${X} ${DIM}(task ids are integers)${X}\n\n" "$id"; return 1
  fi
  local rec; rec="$(store_read | find_task "$id")"
  if [ -z "$rec" ]; then
    printf "\n  ${R}✗ no task${X} ${BD}#%s${X}\n" "$(( 10#$id ))"
    note "list your open tasks with:  skuld list"
    printf "\n"; return 1
  fi
  # porcelain: the one record as a TAB-separated line — same frozen column contract as
  # 'list --porcelain' (see cmd_list). No color, labels, or blank lines.
  if [ "$porcelain" = 1 ]; then printf '%s\n' "$rec" | tr '\037' '\t'; return 0; fi
  local f_id f_status f_priority f_created f_due f_completed f_name f_desc
  IFS="$US" read -r f_id f_status f_priority f_created f_due f_completed f_name f_desc <<< "$rec"

  local nowday; nowday="$(today)"
  local pmark=""; [ "$f_priority" = high ] && pmark="${Y}!${X} "
  local od=""; is_overdue "$f_due" "$f_status" "$nowday" && od="  ${R}(overdue)${X}"
  local statuscol="$G"; [ "$f_status" = closed ] && statuscol="$DIM"

  printf "\n  ${BD}#%s${X}  %s${BD}%s${X}\n\n" "$f_id" "$pmark" "$(dec "$f_name")"
  printf "    ${DIM}status${X}     %s%s${X}\n"    "$statuscol" "$f_status"
  printf "    ${DIM}priority${X}   %s\n"          "$f_priority"
  printf "    ${DIM}created${X}    %s\n"          "$f_created"
  [ -n "$f_due" ]       && printf "    ${DIM}due${X}        %s%s\n" "$f_due" "$od"
  [ -n "$f_completed" ] && printf "    ${DIM}completed${X}  %s\n"   "$f_completed"
  [ -n "$f_desc" ]      && printf "\n    ${DIM}%s${X}\n" "$(dec "$f_desc")"
  printf "\n"
}

# ── close / reopen — the whole state machine: open ⇄ closed ─────────────────────
# close (alias done) stamps 'completed' automatically; reopen clears it and flips back
# to open. Binary and total — there is no third state in v1. Both are gentle no-ops on
# a task already in the target state (so close never re-stamps an earlier completion),
# and both fail cleanly on a non-integer or nonexistent id.
cmd_close(){
  is_help "${1:-}" && { help_close; return 0; }
  local id="" a
  for a in "$@"; do case "$a" in
    -*) printf "  ${Y}ignoring unknown option: %s${X}\n" "$a";;
    *) [ -z "$id" ] && id="$a";;
  esac; done
  ensure_store || return 1
  [ -z "$id" ] && { printf "\n  ${R}usage:${X} skuld close <id>\n\n"; return 1; }
  is_int "$id" || { printf "\n  ${R}✗ not a task id:${X} ${BD}%s${X} ${DIM}(task ids are integers)${X}\n\n" "$id"; return 1; }
  local rec; rec="$(store_read | find_task "$id")"
  if [ -z "$rec" ]; then
    printf "\n  ${R}✗ no task${X} ${BD}#%s${X}\n" "$(( 10#$id ))"
    note "list your open tasks with:  skuld list"; printf "\n"; return 1
  fi
  local name; name="$(dec "$(printf '%s' "$rec" | field 7)")"
  if [ "$(printf '%s' "$rec" | field 2)" = closed ]; then
    printf "\n  ${DIM}·${X} ${BD}#%s${X} is already closed.\n\n" "$(( 10#$id ))"; return 0
  fi
  if ! set_task_state "$id" closed "$(now_iso)"; then
    printf "\n  ${R}✗ couldn't update the task — the store is unchanged.${X}\n\n"; return 1
  fi
  printf "\n  ${G}✓ closed${X} ${DIM}#%s${X} ${BD}%s${X}\n\n" "$(( 10#$id ))" "$name"
}
cmd_reopen(){
  is_help "${1:-}" && { help_reopen; return 0; }
  local id="" a
  for a in "$@"; do case "$a" in
    -*) printf "  ${Y}ignoring unknown option: %s${X}\n" "$a";;
    *) [ -z "$id" ] && id="$a";;
  esac; done
  ensure_store || return 1
  [ -z "$id" ] && { printf "\n  ${R}usage:${X} skuld reopen <id>\n\n"; return 1; }
  is_int "$id" || { printf "\n  ${R}✗ not a task id:${X} ${BD}%s${X} ${DIM}(task ids are integers)${X}\n\n" "$id"; return 1; }
  local rec; rec="$(store_read | find_task "$id")"
  if [ -z "$rec" ]; then
    printf "\n  ${R}✗ no task${X} ${BD}#%s${X}\n" "$(( 10#$id ))"
    note "list all your tasks with:  skuld list"; printf "\n"; return 1
  fi
  local name; name="$(dec "$(printf '%s' "$rec" | field 7)")"
  if [ "$(printf '%s' "$rec" | field 2)" = open ]; then
    printf "\n  ${DIM}·${X} ${BD}#%s${X} is already open.\n\n" "$(( 10#$id ))"; return 0
  fi
  if ! set_task_state "$id" open ""; then
    printf "\n  ${R}✗ couldn't update the task — the store is unchanged.${X}\n\n"; return 1
  fi
  printf "\n  ${G}✓ reopened${X} ${DIM}#%s${X} ${BD}%s${X}\n\n" "$(( 10#$id ))" "$name"
}

# ── edit — change a task's fields (flag-based, for scriptability) ────────────────
# Only the fields you name change; everything else (id, status, created, completed) is
# preserved. The free-text fields are decoded to raw, overridden, then re-encoded by
# build_record — so editing #5's name never disturbs its description's escapes, and a
# tab or newline you type survives. An empty --due/--desc CLEARS that field; --name
# must stay non-empty (a task needs a name).
cmd_edit(){
  is_help "${1:-}" && { help_edit; return 0; }
  local id="" set_name=0 set_desc=0 set_priority=0 set_due=0
  local new_name="" new_desc="" new_priority="" new_due=""
  while [ $# -gt 0 ]; do case "$1" in
    --name)     shift; new_name="${1:-}";     set_name=1;;
    -d|--desc|--description) shift; new_desc="${1:-}"; set_desc=1;;
    -H|--high)  new_priority="high";          set_priority=1;;
    --priority) shift; new_priority="${1:-}"; set_priority=1;;
    --due)      shift; new_due="${1:-}";      set_due=1;;
    --)         shift; [ -z "$id" ] && [ $# -gt 0 ] && { id="$1"; shift; };;
    -*)         printf "  ${Y}ignoring unknown option: %s${X}\n" "$1";;
    *)          [ -z "$id" ] && id="$1";;
  esac; shift; done

  ensure_store || return 1
  [ -z "$id" ] && { printf "\n  ${R}usage:${X} skuld edit <id> [--name …] [-d desc] [--priority …|-H] [--due …]\n\n"; return 1; }
  is_int "$id" || { printf "\n  ${R}✗ not a task id:${X} ${BD}%s${X} ${DIM}(task ids are integers)${X}\n\n" "$id"; return 1; }
  if [ "$(( set_name + set_desc + set_priority + set_due ))" -eq 0 ]; then
    printf "\n  ${R}✗ nothing to edit${X} ${DIM}— give at least one of --name / --desc / --priority / --due.${X}\n\n"; return 1
  fi
  # validate the requested changes BEFORE touching the store
  if [ "$set_priority" = 1 ]; then case "$new_priority" in
    standard|high) ;; *) printf "\n  ${R}✗ unknown priority:${X} ${BD}%s${X} ${DIM}(use: standard | high)${X}\n\n" "$new_priority"; return 1;; esac
  fi
  if [ "$set_due" = 1 ] && [ -n "$new_due" ] && ! valid_due "$new_due"; then
    printf "\n  ${R}✗ invalid --due:${X} ${BD}%s${X} ${DIM}(YYYY-MM-DD, or '' to clear it)${X}\n\n" "$new_due"; return 1
  fi
  if [ "$set_name" = 1 ] && [ -z "${new_name// /}" ]; then
    printf "\n  ${R}✗ a task needs a name${X} ${DIM}(--name can't be empty).${X}\n\n"; return 1
  fi

  local rec; rec="$(store_read | find_task "$id")"
  if [ -z "$rec" ]; then
    printf "\n  ${R}✗ no task${X} ${BD}#%s${X}\n" "$(( 10#$id ))"
    note "list your tasks with:  skuld list"; printf "\n"; return 1
  fi
  local c_id c_status c_priority c_created c_due c_completed c_name c_desc
  IFS="$US" read -r c_id c_status c_priority c_created c_due c_completed c_name c_desc <<< "$rec"
  c_name="$(dec "$c_name")"; c_desc="$(dec "$c_desc")"          # to raw before overriding
  [ "$set_name" = 1 ]     && c_name="$new_name"
  [ "$set_desc" = 1 ]     && c_desc="$new_desc"
  [ "$set_priority" = 1 ] && c_priority="$new_priority"
  [ "$set_due" = 1 ]      && c_due="$new_due"

  local newrec; newrec="$(build_record "$c_id" "$c_status" "$c_priority" "$c_created" "$c_due" "$c_completed" "$c_name" "$c_desc")"
  if ! replace_task "$id" "$newrec"; then
    printf "\n  ${R}✗ couldn't update the task — the store is unchanged.${X}\n\n"; return 1
  fi
  printf "\n  ${G}✓ edited${X} ${DIM}#%s${X} ${BD}%s${X}\n\n" "$(( 10#$id ))" "$c_name"
}

# confirm <question> — ask once, reading /dev/tty directly so a piped/redirected stdin
# can't silently auto-confirm a delete. Probe that /dev/tty can actually be OPENED (in
# some sandboxes the node exists but opening it fails), and never leave reply unset under
# `set -u`. The pack's safety spine — the gate for rm. Returns 0 to proceed, 1 to abort.
confirm(){
  local reply=""
  if ! { : < /dev/tty; } 2>/dev/null; then
    printf "  ${Y}no usable terminal for confirmation — pass --force to proceed non-interactively.${X}\n" >&2
    return 1
  fi
  printf "  ${Y}%s${X} ${DIM}[y/N]${X} " "$1" > /dev/tty 2>/dev/null
  read -r reply < /dev/tty 2>/dev/null || reply=""
  case "$reply" in y|Y|yes|YES) return 0;; *) return 1;; esac
}

# ── rm — soft-delete a task to $SKULD_HOME/.trash/ (never a hard delete) ─────────
# The one destructive-adjacent verb, and it is NEVER a hard delete: the record is first
# APPENDED to the trash ledger ($SKULD_HOME/.trash/tasks.tsv) — so it's saved before the
# main store loses it — and only then removed from the store atomically. If the second
# step fails, the task is duplicated (recoverable), never lost. Confirms once via
# /dev/tty (a pipe can't auto-confirm); --force skips the prompt.
cmd_rm(){
  is_help "${1:-}" && { help_rm; return 0; }
  local id="" force=0 a
  for a in "$@"; do case "$a" in
    -f|--force|-y|--yes) force=1;;
    -*) printf "  ${Y}ignoring unknown option: %s${X}\n" "$a";;
    *) [ -z "$id" ] && id="$a";;
  esac; done
  ensure_store || return 1
  [ -z "$id" ] && { printf "\n  ${R}usage:${X} skuld rm <id> [--force]\n\n"; return 1; }
  is_int "$id" || { printf "\n  ${R}✗ not a task id:${X} ${BD}%s${X} ${DIM}(task ids are integers)${X}\n\n" "$id"; return 1; }
  local rec; rec="$(store_read | find_task "$id")"
  if [ -z "$rec" ]; then
    printf "\n  ${R}✗ no task${X} ${BD}#%s${X}\n" "$(( 10#$id ))"
    note "list your tasks with:  skuld list"; printf "\n"; return 1
  fi
  local name; name="$(dec "$(printf '%s' "$rec" | field 7)")"

  if [ "$force" != 1 ] && ! confirm "remove #$(( 10#$id )) \"$name\"?  (it moves to the trash)"; then
    printf "  ${DIM}aborted — nothing removed.${X}\n\n"; return 0
  fi

  # 1. save the record to the trash ledger FIRST (append; the record is never lost)…
  mkdir -p "$TRASH"
  if ! printf '%s\n' "$rec" | tr '\037' '\t' >> "$TRASH/tasks.tsv"; then
    printf "\n  ${R}✗ couldn't write to the trash — nothing removed.${X}\n\n"; return 1
  fi
  # 2. …then rewrite the store without this record (atomic).
  if ! store_read | awk -v id="$id" 'BEGIN{ FS="\037" } ($1+0)!=(id+0)' | store_write; then
    printf "\n  ${R}✗ couldn't update the store — the task is still present (and now also in the trash).${X}\n\n"; return 1
  fi
  printf "\n  ${G}✓ removed${X} ${DIM}#%s${X} ${BD}%s${X} ${DIM}→ %s${X}\n" "$(( 10#$id ))" "$name" "$TRASH/tasks.tsv"
  note "it's soft-deleted — the record is recoverable from the trash ledger above."
  printf "\n"
}


# ── dispatch — verbs win the first position; two non-verb arms are the defaults ──
# The dispatcher is CLOSED: only the fixed verb set reaches the first position. The
# two non-verb arms are the design's ergonomic defaults — an empty invocation lists
# open tasks (the daily driver), and a bare integer shows that task (an integer is
# unambiguously not a verb). Nothing else free-form reaches this position.
case "${1:-}" in
  add|new)                shift; cmd_add "$@";;
  edit)                   shift; cmd_edit "$@";;
  close|done)             shift; cmd_close "$@";;
  reopen)                 shift; cmd_reopen "$@";;
  rm|del)                 shift; cmd_rm "$@";;
  list|ls)                shift; cmd_list "$@";;
  show|view)              shift; cmd_show "$@";;
  init)                   shift; cmd_init "$@";;
  help|-h|--help)         cmd_help;;
  version|-V|--version)   printf "skuld %s\n" "$VERSION";;
  "")                     cmd_list;;
  *)
    if is_int "$1"; then
      cmd_show "$1"
    else
      printf "\n  ${R}no such command:${X} ${BD}%s${X}\n" "$1"
      note "a bare number shows that task; otherwise use a verb (see 'skuld help')."
      cmd_help
      exit 1
    fi
    ;;
esac
